{
  "name": "@moyai/pi-session-hoarder",
  "version": "0.1.0",
  "description": "🐿️ A Pi extension that archives sessions into local content-addressed storage.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/moyai-ai/pi-session-hoarder#readme",
  "bugs": {
    "url": "https://github.com/moyai-ai/pi-session-hoarder/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyai-ai/pi-session-hoarder.git"
  },
  "files": [
    "src",
    "assets/moyai-gallery-preview.png"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src test *.ts",
    "lint:fix": "oxlint --fix src test *.ts",
    "format": "oxfmt --write src test .fallowrc.jsonc .oxlintrc.json .oxfmtrc.json package.json tsconfig.json vitest.config.ts vitest.s3.config.ts",
    "format:check": "oxfmt --check src test .fallowrc.jsonc .oxlintrc.json .oxfmtrc.json package.json tsconfig.json vitest.config.ts vitest.s3.config.ts",
    "typecheck": "tsc --noEmit",
    "analyze": "fallow --type-aware",
    "analyze:check": "fallow --type-aware --fail-on-issues",
    "analyze:audit": "fallow audit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:s3": "vitest run --config vitest.s3.config.ts",
    "check:remote": "npm run typecheck && npm run test:s3",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run analyze:check",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@aws-sdk/credential-provider-node": "3.972.78"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@testcontainers/minio": "12.1.0",
    "@types/node": "24.12.4",
    "@vitest/coverage-istanbul": "4.1.9",
    "fallow": "3.12.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/moyai-ai/pi-session-hoarder/main/assets/moyai-gallery-preview.png"
  }
}
